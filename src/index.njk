---
layout: default
pagination:
    data: collections.pagedPosts
    size: 1
    alias: paged
permalink: "{% if paged.number > 1 %}page/{{ paged.number }}/{% endif %}index.html"
---

{% if paged.number == 1 %}
<section class="mb-8 text-center sm:text-left border-b border-slate-100 pb-8">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-teal-700 bg-white rounded-full mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-red-300 animate-pulse"></span>
        Latest Articles
    </div>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mb-3">
        {{ site.title }}
    </h1>
    <p class="text-base sm:text-lg text-slate-600 max-w-2xl leading-relaxed">
        {{ site.description }}
    </p>
</section>
{% else %}
<div class="mb-8 pb-4 border-slate-100 flex items-center justify-between">
    <h1 class="text-xl font-bold text-slate-900">Articles - Page {{ paged.number }}</h1>
    <a href="{{ '/' | url }}" class="text-xs font-semibold text-teal-600 hover:text-teal-700">← Back to page 1</a>
</div>
{% endif %}

<div class="flex flex-wrap -mx-3">
    {% include "partials/post-grid.njk" %}
</div>

{% if collections.posts.length > site.paginate %}
{% include "partials/paginator.njk" %}
{% endif %}