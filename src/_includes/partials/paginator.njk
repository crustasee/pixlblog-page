<div class="mt-10 pt-6 border-t border-slate-100 flex items-center justify-between">
    <a href="{% if not paged.first %}{{ pagination.href.previous | url }}{% else %}javascript:void(0){% endif %}" 
       class="inline-flex items-center gap-1.5 bg-white font-medium py-2 px-4 text-xs sm:text-sm border border-slate-200 rounded-lg shadow-sm text-slate-800 {% if not paged.first %}cursor-pointer hover:bg-slate-50 hover:border-slate-300 transition-all{% else %}cursor-default text-slate-300 border-slate-100 shadow-none{% endif %}">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        <span>Previous</span>
    </a>
    <span class="text-xs text-slate-400 font-medium">Page {{ paged.number }}</span>
    <a href="{% if not paged.last %}{{ pagination.href.next | url }}{% else %}javascript:void(0){% endif %}" 
       class="inline-flex items-center gap-1.5 bg-white font-medium py-2 px-4 text-xs sm:text-sm border border-slate-200 rounded-lg shadow-sm text-slate-800 {% if not paged.last %}cursor-pointer hover:bg-slate-50 hover:border-slate-300 transition-all{% else %}cursor-default text-slate-300 border-slate-100 shadow-none{% endif %}">
        <span>Next</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
    </a>
</div>