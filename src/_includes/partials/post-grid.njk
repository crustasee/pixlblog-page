{%- set lazyImage = "data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2016%209'%20style%3D'background-color%3Argb(226%2C232%2C240)'%2F%3E" -%}
{% for post in paged.posts %}
<article class="w-full sm:w-1/2 md:w-1/3 p-3 flex flex-col">
    <div class="group h-full bg-white rounded-xl shadow-sm hover:shadow-xl border border-slate-200/80 transition-all duration-300 ease-out hover:-translate-y-1.5 overflow-hidden flex flex-col">
        <!-- Thumbnail Container dengan ukuran konsisten & efek hover scale -->
        <a href="{{ post.url | url }}" class="block relative w-full aspect-video overflow-hidden bg-slate-100">
            <img class="w-full h-full object-cover object-center m-0 transform group-hover:scale-105 transition-transform duration-500 ease-out lazy" 
                 src="{{ lazyImage }}" 
                 data-src="{% if post.data.thumb %}{{ post.data.thumb | url }}{% else %}{{ '/assets/img/no-image.svg' | url }}{% endif %}" 
                 width="960" 
                 height="540" 
                 alt="{{ post.data.title }}">
            <div class="absolute inset-0 bg-slate-900/0 group-hover:bg-slate-900/5 transition-colors duration-300"></div>
        </a>
        <div class="p-5 sm:p-6 flex flex-col flex-grow">
            {% if post.data.tags and post.data.tags.length %}
            <div class="flex flex-wrap gap-1.5 mb-2.5">
                {% for tag in post.data.tags %}
                {% if loop.index <= 2 %}
                <span class="text-[11px] font-medium text-teal-700 bg-teal-50 px-2 py-0.5 rounded-md">#{{ tag }}</span>
                {% endif %}
                {% endfor %}
            </div>
            {% endif %}
            <h2 class="font-bold text-lg leading-snug mb-2 text-slate-900 group-hover:text-teal-600 transition-colors">
                <a href="{{ post.url | url }}">{{ post.data.title }}</a>
            </h2>
            <div class="flex items-center text-xs text-slate-500 mb-3" title="Published date">
                <svg class="w-3.5 h-3.5 mr-1.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                <span>{{ post.data.page.date | readableDate }}</span>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed flex-grow">
                {% if post.data.description %}
                {{ post.data.description }}
                {% else %}
                {{ post.templateContent | striptags | truncate(110, true) }}
                {% endif %}
            </p>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-teal-600">
                <a href="{{ post.url | url }}" class="inline-flex items-center group-hover:translate-x-1 transition-transform duration-200">
                    Read article
                    <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</article>
{% endfor %}